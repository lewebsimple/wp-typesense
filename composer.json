{
  "name": "lewebsimple/wp-typesense",
  "type": "wordpress-plugin",
  "autoload": {
    "psr-4": {
      "Websimple\\WpTypesense\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "prefer-stable": true,
  "require": {
    "monolog/monolog": "^2.9",
    "php-http/curl-client": "*",
    "psr/log": "^1.1 || ^2.0",
    "symfony/http-client": "*",
    "typesense/typesense-php": "*"
  },
  "require-dev": {
    "php-stubs/wp-cli-stubs": "*"
  }
}